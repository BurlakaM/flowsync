// Conventions: PascalCase models, camelCase fields; the database uses snake_case plural tables
// and snake_case columns (@@map / @map). Every foreign key has an index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String
  role                Role      @default(USER)
  /// Null until the owner of the mailbox follows the link in the verification email. Unverified
  /// addresses get no notification emails, so signing up with someone else's address cannot spam them.
  emailVerifiedAt     DateTime? @map("email_verified_at")
  /// Access tokens issued before this moment are refused: changing or resetting the password ends every session at once.
  passwordChangedAt   DateTime? @map("password_changed_at")
  /// Consecutive wrong passwords; reset by a successful sign-in. Reaching the limit sets lockedUntil.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  createdTasks  Task[]          @relation("TaskCreator")
  assignments   TaskAssignee[]
  comments      Comment[]
  refreshTokens RefreshToken[]
  userTokens    UserToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  /// Key of the project picture in the file storage (not a URL); the API never exposes it, only `hasImage`.
  image       String?
  ownerId     Int      @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // A user who owns projects cannot be deleted until the projects are moved or removed.
  owner     User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  tasks     Task[]
  tags      Tag[]
  auditLogs AuditLog[]

  @@index([ownerId])
  @@map("projects")
}

/// Members of a project other than its owner.
model ProjectMember {
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  status      TaskStatus @default(TODO)
  /// Optimistic concurrency: every update must name the version it was based on and bumps it, so
  /// two people editing the same task never silently overwrite each other.
  version     Int        @default(1)
  projectId   Int        @map("project_id")
  createdById Int?       @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting the author keeps the task.
  createdBy User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]
  tags      Tag[]          @relation("TaskTags")
  comments  Comment[]

  @@index([projectId, status])
  @@index([createdById])
  @@map("tasks")
}

model TaskAssignee {
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  taskId    Int      @map("task_id")
  authorId  Int?     @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Deleting the author keeps the discussion.
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Comments are read oldest first by cursor (the id); the leading column still serves the foreign key.
  @@index([taskId, id])
  @@index([authorId])
  @@map("comments")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String
  projectId Int      @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]  @relation("TaskTags")

  @@unique([projectId, name])
  @@map("tags")
}

/// One row per issued refresh token. Only the SHA-256 hash is stored: a leaked table cannot be replayed.
/// Tokens of one sign-in form a family; reusing a revoked token revokes the whole family.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// The activity feed of a project: one row per domain event (who did what to which entity).
/// Rows go away with their project; they stay (without an actor) when the author's account is deleted.
model AuditLog {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  actorId    Int?     @map("actor_id")
  type       String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  data       Json
  /// The outbox event this row came from. Unique, so delivering the same event twice writes one row.
  eventId    String?  @unique @map("event_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // The feed is read newest first by cursor (the id), so the index follows that order.
  @@index([projectId, id(sort: Desc)])
  @@index([actorId])
  @@map("audit_logs")
}

/// An in-application notification for one user ("you were assigned", "new comment"). The text is built
/// by the client from `type` and `data`, so it can be translated.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  data      Json
  readAt    DateTime? @map("read_at")
  /// The outbox event that caused it; with `userId` unique, a redelivered event never notifies twice.
  eventId   String?   @map("event_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

enum OutboxStatus {
  PENDING
  DONE
  /// Gave up after too many attempts; needs a human (see docs/OPERATIONS.md).
  DEAD
}

/// Transactional outbox: a domain event is written in the same transaction as the change that caused
/// it, so a crash can never save the change and lose the event. A relay delivers the rows to the
/// subscribers (audit log, notifications, real-time) at least once, which is why they are idempotent.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  /// Also the lease: a row being delivered is pushed into the future, so a crashed worker's rows come back.
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

enum UserTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// A one-time secret sent by email (password reset, email verification). Only the SHA-256 hash is stored,
/// so a leaked database cannot be used to reset anyone's password.
model UserToken {
  id        Int           @id @default(autoincrement())
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  userId    Int           @map("user_id")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}
