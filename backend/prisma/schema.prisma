// Conventions: PascalCase models, camelCase fields; the database uses snake_case plural tables
// and snake_case columns (@@map / @map). Every foreign key has an index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  createdTasks  Task[]          @relation("TaskCreator")
  assignments   TaskAssignee[]
  comments      Comment[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  image       String?
  ownerId     Int      @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // A user who owns projects cannot be deleted until the projects are moved or removed.
  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks   Task[]
  tags    Tag[]

  @@index([ownerId])
  @@map("projects")
}

/// Members of a project other than its owner.
model ProjectMember {
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  status      TaskStatus @default(TODO)
  projectId   Int        @map("project_id")
  createdById Int?       @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting the author keeps the task.
  createdBy User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]
  tags      Tag[]          @relation("TaskTags")
  comments  Comment[]

  @@index([projectId, status])
  @@index([createdById])
  @@map("tasks")
}

model TaskAssignee {
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  taskId    Int      @map("task_id")
  authorId  Int?     @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Deleting the author keeps the discussion.
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String
  projectId Int      @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]  @relation("TaskTags")

  @@unique([projectId, name])
  @@map("tags")
}

/// One row per issued refresh token. Only the SHA-256 hash is stored: a leaked table cannot be replayed.
/// Tokens of one sign-in form a family; reusing a revoked token revokes the whole family.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
