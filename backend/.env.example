# Used by `npm run start:dev` / tests on the host (the database runs in Docker on host port 5433).
# Inside Docker, compose overrides DATABASE_URL and only SECRET_KEY is taken from this file.
DATABASE_URL="postgresql://postgres:change-me@localhost:5433/flowsync"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: comma-separated allowed origins (defaults to the local frontends).
# CORS_ORIGINS=http://localhost:8080,http://localhost:3001
