# Used by `npm run start:dev` on the host (the database runs in Docker on host port 5433).
# Inside Docker, compose overrides DATABASE_URL and only JWT_SECRET is taken from this file.
# The application refuses to start when a required variable is missing or invalid.
DATABASE_URL="postgresql://postgres:change-me@localhost:5433/flowsync"
# Secret used to sign access tokens. In production it must be at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional (defaults in parentheses)
# JWT_EXPIRES_IN=15m               (15m)  lifetime of an access token, e.g. 15m, 1h
# REFRESH_TOKEN_TTL_DAYS=7          (7)  lifetime of a session (the refresh cookie), 1-90 days
# COOKIE_SECURE=false               (false)  set true when the site is served over HTTPS
# CORS_ORIGINS=http://localhost:8080,http://localhost:3001   (the local frontends)
# LOG_LEVEL=info                    (info)  fatal|error|warn|info|debug|trace|silent
# BCRYPT_ROUNDS=10                  (10)  bcrypt cost, 4-15 (higher = slower and safer)
# PORT=3000                         (3000)
# TRUST_PROXY=0                     (0)  number of reverse proxies in front of the API

# --- Email and queue (all optional) -------------------------------------------------------------
# Notifications always appear in the application. Email is sent only when SMTP_HOST and MAIL_FROM are
# both set; until then nothing is sent and nothing fails. Put the real values here when you have them
# (the lines below are placeholders to copy and fill in; for local development the compose stack
# already runs Mailpit, a fake mail server with a web page on http://localhost:8025).
# SMTP_HOST=smtp.example.com        server of your email provider
# SMTP_PORT=587                     (587)  465 with SMTP_SECURE=true, 25 or 1025 for plain servers
# SMTP_SECURE=false                 (false)  true = TLS from the first byte
# SMTP_USER=your-smtp-username      leave empty for servers without a login
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM="FlowSync <noreply@example.com>"
# APP_URL=http://localhost:5173     (http://localhost:5173)  where links in emails lead
#
# Redis makes the queue durable: emails are retried and survive a restart. Compose sets it for you.
# Without it emails are sent inside the API process (fine for development).
# REDIS_URL=redis://localhost:6379

# --- File storage (optional) -----------------------------------------------------------------------
# Project pictures are stored in any S3-compatible service. Uploading is on when S3_ACCESS_KEY and
# S3_SECRET_KEY are both set; until then everything else works and uploading answers 503.
# (The development compose stack runs MinIO and configures this for you.)
# S3_ENDPOINT=https://s3.example.com     leave out for AWS S3 itself
# S3_BUCKET=flowsync                     (flowsync)  created on start when it does not exist
# S3_REGION=us-east-1                    (us-east-1)
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=true               (true)  host/bucket/key addresses; false for virtual-hosted style

# End-to-end tests run on their own disposable database (never on DATABASE_URL):
#   docker compose --profile test up -d db_test
# TEST_DATABASE_URL="postgresql://postgres:change-me@localhost:5434/flowsync_test"
