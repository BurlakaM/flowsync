# TLS termination in front of the frontend container (nginx), which serves the SPA and proxies /api,
# including the WebSocket upgrade for /api/socket.io. Caddy handles that upgrade by itself.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:8080 {
		# Health-aware: a failed readiness probe takes the upstream out instead of serving 502s.
		health_uri /api/health/ready
		health_interval 10s
	}
	# HSTS only here: this is the layer that actually speaks HTTPS.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
