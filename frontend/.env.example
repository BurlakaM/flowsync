# All variables are optional and exposed to the browser (do not put secrets here).

# Base URL of the API. The default `/api` is right everywhere: nginx proxies it in production
# and the Vite dev server proxies it in development.
# VITE_API_URL=/api

# Dev server only: where the Vite proxy sends /api (in Docker compose it is http://backend:3000).
# VITE_PROXY_TARGET=http://localhost:3000

# Error reporting (Sentry). Optional; without it nothing is sent. In production the DSN host must be
# added to connect-src in security-headers.conf, otherwise the CSP blocks the reports.
# VITE_SENTRY_DSN=
